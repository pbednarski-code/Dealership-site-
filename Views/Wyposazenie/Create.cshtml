@model DealerAutoMVC.Models.Wyposazenie

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Wyposazenie</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ModelSamochoduId" class="control-label"></label>
                <select asp-for="ModelSamochoduId" class ="form-control" asp-items="ViewBag.ModelSamochoduId"></select>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Klimatyzacja" /> @Html.DisplayNameFor(model => model.Klimatyzacja)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Nawigacja" /> @Html.DisplayNameFor(model => model.Nawigacja)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="SkorzanaTapicerka" /> @Html.DisplayNameFor(model => model.SkorzanaTapicerka)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="KameraCofania" /> @Html.DisplayNameFor(model => model.KameraCofania)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="CzujnikiParkowania" /> @Html.DisplayNameFor(model => model.CzujnikiParkowania)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="AppleCarPlay" /> @Html.DisplayNameFor(model => model.AppleCarPlay)
                </label>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
